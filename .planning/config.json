{
  "mode": "yolo",
  "granularity": "coarse",
  "workflow": {
    "research": false,
    "plan_check": false,
    "verifier": false,
    "auto_advance": true,
    "nyquist_validation": false,
    "security_enforcement": true,
    "security_asvs_level": 1,
    "security_block_on": "high"
  },
  "planning": {
    "commit_docs": true,
    "search_gitignored": false,
    "sub_repos": []
  },
  "parallelization": {
    "enabled": true,
    "plan_level": true,
    "task_level": false,
    "skip_checkpoints": true,
    "max_concurrent_agents": 3,
    "min_plans_for_parallel": 2
  },
  "gates": {
    "confirm_project": false,
    "confirm_phases": false,
    "confirm_roadmap": false,
    "confirm_breakdown": false,
    "confirm_plan": false,
    "execute_next_plan": false,
    "issues_review": false,
    "confirm_transition": false
  },
  "safety": {
    "always_confirm_destructive": false,
    "always_confirm_external_services": false
  },
  "hooks": {
    "context_warnings": true
  },
  "project_code": "teamtask",
  "claude_md_path": "./CLAUDE.md"
}
